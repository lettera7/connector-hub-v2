{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["node"],
    "incremental": false,
    "tsBuildInfoFile": ".test-build/tsconfig.test.tsbuildinfo"
  },
  "include": ["lib/planner/**/*.ts", "tests/**/*.test.ts"]
}
